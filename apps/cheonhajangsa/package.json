    "react-hook-form": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@electric-sql/pglite-postgis": "^0.2.12",
    "@playwright/test": "latest",
    "@tailwindcss/postcss": "latest",
    "@types/node": "^24",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "^9.39.1",
    "eslint-config-next": "latest",
    "tailwindcss": "latest",
