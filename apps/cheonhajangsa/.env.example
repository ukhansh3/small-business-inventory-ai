# Kakao Maps JavaScript SDK: 브라우저 공개용 JavaScript 키입니다.
# REST/Admin 키를 넣지 마세요. 아래 다른 서비스는 아직 연결하지 않았습니다.
# .env.local에 설정하고 허용 SDK 도메인에 http://127.0.0.1:4310 및 http://localhost:4310을 등록하세요.
NEXT_PUBLIC_KAKAO_MAP_JAVASCRIPT_KEY=
KAKAO_REST_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
