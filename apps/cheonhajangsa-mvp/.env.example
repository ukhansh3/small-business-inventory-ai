# 서버 전용. 값은 .env.local(커밋 금지) 또는 Vercel 환경 변수에만 넣는다.
# 실시간 AI용 Anthropic API 키. 없으면 AI_MODE=stored만 가능
ANTHROPIC_API_KEY=
# live 또는 stored
AI_MODE=stored
# 기본 claude-haiku-5-5
AI_MODEL=claude-haiku-5-5
# AI 응답 대기 한도(ms)
AI_TIMEOUT_MS=8000
# 사진 읽기 응답 대기 한도(ms, 기본 20000, v2 단가 진단)
AI_VISION_TIMEOUT_MS=20000
# 하루 AI 호출 한도
AI_DAILY_LIMIT=500
# 내 Supabase 주소. 비우면 기록을 건너뛴다
SUPABASE_URL=
# Supabase 서비스 키. 앱 번들에 절대 넣지 않는다
SUPABASE_SERVICE_ROLE_KEY=
# true일 때만 X-Debug-Now, X-AI-Mode 헤더 적용. 배포는 false
ALLOW_DEBUG_HEADERS=false
# 로컬 API 서버 포트
DEV_API_PORT=8787

# 앱(공개). 배포는 비움(같은 출처). 로컬 개발도 비워 두면 개발 빌드가 http://localhost:8787을 쓴다
EXPO_PUBLIC_API_BASE_URL=

# 앱(공개). 카카오맵 JavaScript 키. 카카오 개발자 콘솔에 등록된 도메인에서만 동작한다(v2 지도)
EXPO_PUBLIC_KAKAO_JS_KEY=
