# 앱에는 공개 설정만 넣습니다. 관리자·REST·OpenAI 키는 서버에만 보관합니다.
# 기존 Next.js 앱을 HTTPS로 배포한 주소의 /mobile-map 경로
EXPO_PUBLIC_KAKAO_MAP_URL=https://cheonhajangsa.vercel.app/mobile-map
# 민균 브랜치의 서버 origin. DB 적용·서버 배포 후 설정하며 /api/v1은 붙이지 않습니다.
EXPO_PUBLIC_API_BASE_URL=

# 로그인·업체 등록 기능 (공개 값만 설정)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
